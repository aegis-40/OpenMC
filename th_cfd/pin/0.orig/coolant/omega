/*--------------------------------*- C++ -*----------------------------------*\
| NuScale pin_clean - COOLANT specific dissipation rate                          |
|  omega_in = sqrt(k)/(Cmu^0.25 * l), l = 0.07*D_h -> ~330 1/s                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/coolant";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 330;

boundaryField
{
    inlet           { type fixedValue; value uniform 330; }
    outlet          { type inletOutlet; inletValue uniform 330; value uniform 330; }
    sides           { type symmetry; }
    coolant_to_clad { type omegaWallFunction; value uniform 330; }
}

// ************************************************************************* //
