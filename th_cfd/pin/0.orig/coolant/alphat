/*--------------------------------*- C++ -*----------------------------------*\
| NuScale pin_clean - COOLANT turbulent thermal diffusivity (Jayatilleke wall fn) |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/coolant";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet           { type calculated; value uniform 0; }
    outlet          { type calculated; value uniform 0; }
    sides           { type symmetry; }
    coolant_to_clad
    {
        type            compressible::alphatJayatillekeWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
}

