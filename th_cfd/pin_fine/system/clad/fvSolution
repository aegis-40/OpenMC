/*--------------------------------*- C++ -*----------------------------------*\
| NuScale pin_clean - CLAD (solid) fvSolution                                     |
|  CLEAN: relTol 0.01 (was 0.1) ; nNonOrthogonalCorrectors 2 (was 0).            |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/clad";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    h
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.01;
    }
    hFinal { $h; relTol 0; }
}

PIMPLE { nNonOrthogonalCorrectors 2; }

relaxationFactors { equations { h 1; } }

// ************************************************************************* //
