/*--------------------------------*- C++ -*----------------------------------*\
| AEGIS-40 - COOLANT velocity. New design: core-avg G 543 -> u_in 0.7255 m/s (was 1.108).|
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/coolant";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0.7255);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 0.7255);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0.7255);
    }
    sides           { type symmetry; }
    coolant_to_clad { type noSlip; }
}

// ************************************************************************* //
